<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"> <!-- ✅ 수정: 상태바와 겹치지 않게 -->>

    <!-- ✅ 수정 : ScrollView를 ConstraintLayout 안에 넣어 상단 배터리 표시와 겹치지 않도록 함 -->
    <ScrollView
        android:id="@+id/profileScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <!-- ✅ 임티 수정 : 상단 제목과 버튼 행 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/ProfileSetTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="프로필 설정"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/bnt_setting_save"
                    android:layout_width="80dp"
                    android:layout_height="40dp"
                    android:text="설정 저장"
                    android:textColor="@color/black"
                    android:backgroundTint="#DFF1FF"
                    android:textSize="16sp"
                    android:background="@drawable/round_background_15"
                    android:gravity="center"
                    android:padding="0dp"/>
            </LinearLayout>

            <!-- 이름 -->
            <TextView
                android:id="@+id/NicknameTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="닉네임"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/textColor"
                android:layout_marginTop="24dp" />

            <EditText
                android:id="@+id/NicknameEditText"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:hint="이름 입력"
                android:background="@drawable/edittext_background"
                android:padding="5dp"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:layout_marginTop="8dp"/>

            <!-- 태그 아이디 -->
            <TextView
                android:id="@+id/UserIDTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="태그 아이디"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/textColor"
                android:layout_marginTop="18dp" />

            <EditText
                android:id="@+id/UserIDEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint=" 영문자, 숫자, 마침표, 밑줄만 포함"
                android:layout_marginTop="12dp"
                android:background="@drawable/edittext_background"
                android:padding="8dp" />

            <!-- 소개글 -->
            <TextView
                android:id="@+id/BioTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="소개글"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/textColor"
                android:layout_marginTop="20dp" />

            <EditText
                android:id="@+id/BioEditText"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:hint="그룹 소개글을 작성 (200자 이하)"
                android:gravity="top"
                android:background="@drawable/edittext_background"
                android:padding="12dp"
                android:inputType="textMultiLine"
                android:maxLength="500"
                android:layout_marginTop="12dp"/>

            <!-- 프로필 이미지 -->
            <TextView
                android:id="@+id/Profile_img_Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="프로필 이미지"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/textColor"
                android:layout_marginTop="20dp" />

            <!-- ✅ 수정: 회색 테두리 둥근 흰색 버튼, 텍스트 '사진 불러오기' -->
            <Button
                android:id="@+id/bnt_ProfileImage"
                android:layout_width="150dp"
                android:layout_height="45dp"
                android:text="사진 불러오기"
                android:textColor="@color/hintColor"
                android:textSize="16sp"
                android:layout_marginTop="5dp"
                android:padding="0dp"
                android:backgroundTint="@android:color/white"
                app:cornerRadius="8dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/gray"/>

            <!-- 이미지 업로드 -->
            <ImageView
                android:id="@+id/profile_imageView"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="bottom"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="20dp"
                android:scaleType="centerCrop" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
