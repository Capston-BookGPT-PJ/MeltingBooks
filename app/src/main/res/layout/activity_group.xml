<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/browseLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/feed_background">

    <!-- 상단 바 (고정) -->
    <!--✅ 수정: Relative에서 ConstraintLayout으로 변경 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/top_bar_background"
        android:fitsSystemWindows="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 중앙 로고 -->
        <ImageView
            android:id="@+id/topBarImage"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/meltingbooks_toplog"
            android:contentDescription="Top Logo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- 중간 콘텐츠 영역 (스크롤 가능 영역) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

        <!-- 버튼 영역 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <!-- ✅ 새 그룹 만들기 버튼 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/createGroupButton"
                android:layout_width="170dp"
                android:layout_height="60dp"
                android:text="새 그룹 만들기"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:backgroundTint="@android:color/white"
                app:strokeColor="@color/gray"
                app:strokeWidth="1dp"
                app:cornerRadius="15dp"
                android:gravity="center"
                android:textAllCaps="false"
                android:layout_marginEnd="15dp"/>

            <!-- ✅ 그룹 검색 버튼 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/searchGroupButton"
                android:layout_width="170dp"
                android:layout_height="60dp"
                android:text="그룹 검색"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:backgroundTint="@android:color/white"
                app:strokeColor="@color/gray"
                app:strokeWidth="1dp"
                app:cornerRadius="15dp"
                android:gravity="center"
                android:textAllCaps="false" />


        </LinearLayout>

            <!-- 추천 그룹 미리보기 카드 + 추가 버튼 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <ImageButton
                    android:id="@+id/myGroup1"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:background="@drawable/group_create"
                    android:layout_marginEnd="30dp"
                    android:paddingBottom="5dp"
                    android:scaleType="centerInside"
                    android:adjustViewBounds="true"/>

                <ImageButton
                    android:id="@+id/myGroup2"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:paddingBottom="5dp"
                    android:background="@drawable/group_create"
                    android:scaleType="centerInside"
                    android:adjustViewBounds="true"/>

                <ImageButton
                    android:id="@+id/myGroup3"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_marginStart="30dp"
                    android:paddingBottom="5dp"
                    android:scaleType="centerInside"
                    android:background="@drawable/group_create"
                    android:adjustViewBounds="true"/>
            </LinearLayout>


            <!--✅  인기 그룹 섹션: 첫 번째 카드 시작점과 텍스트 시작점 정렬 -->
            <LinearLayout
                android:id="@+id/popularGroupsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/round_background_15"
                android:layout_marginBottom="10dp">

                <!-- 인기 그룹 제목 -->
                <TextView
                    android:id="@+id/popularGroupsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="25dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:text="인기 그룹"
                    android:textSize="22sp"
                    android:textColor="@color/black" />

                <!-- 인기 그룹 카드 RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/popularGroupsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="12dp"
                    android:clipToPadding="false"
                    android:paddingTop="0dp"
                    android:gravity="center"/>
            </LinearLayout>

            <!--✅  최신 그룹 섹션: 첫 번째 카드 시작점과 텍스트 시작점 정렬 -->
            <LinearLayout
                android:id="@+id/recentGroupsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/round_background_15"
                android:layout_marginBottom="20dp">

                <!-- 최신 그룹 제목 -->
                <TextView
                    android:id="@+id/recentGroupsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="25dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:text="최신 그룹"
                    android:textSize="22sp"
                    android:textColor="@color/black" />

                <!-- 최신 그룹 카드 RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recentGroupsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="12dp"
                    android:clipToPadding="false"
                    android:paddingTop="0dp"
                    android:gravity="center"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>


    <!-- 하단 메뉴바 보완필요 -->
    <RelativeLayout
        android:id="@+id/bottomNavigationLayout"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginBottom="11dp"
        android:layout_marginHorizontal="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/round_background_20"/>

        <ImageView
            android:id="@+id/gradientCircle"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_centerVertical="true"
            android:layout_centerHorizontal="true"
            android:background="@drawable/gra_cir_img" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigationView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/transparency"
            app:itemIconTint="@drawable/nav_item_selector"
            app:menu="@menu/bottom_nav_menu"/>
    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
