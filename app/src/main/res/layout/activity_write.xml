<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activityWriteRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fitsSystemWindows="true">

    <!-- 상단 바: 감상문 작성 + 업로드 버튼 -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="감상문 작성"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="20dp"/>

    <ImageButton
        android:id="@+id/btnUpload"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/write_upload"
        android:scaleType="centerInside"
        android:padding="2dp"
        app:layout_constraintTop_toTopOf="@id/tvTitle"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="20dp"/>

    <!-- ScrollView: 프로필 + EditText + 별점 + 책 정보 -->
    <!-- ScrollView: 프로필 + EditText + 요약 버튼 + 별점 + 책 정보 -->
    <ScrollView
        android:id="@+id/scrollInput"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintBottom_toTopOf="@id/hashtagLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            android:padding="10dp">

            <!-- 프로필 이미지 + 입력 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp">

                <ImageView
                    android:id="@+id/profileImage"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/sample_profile"
                    android:scaleType="centerCrop"
                    android:background="@drawable/profile_image_background"
                    android:clipToOutline="true"/>

                <EditText
                    android:id="@+id/etInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:textColor="@color/textColor"
                    android:textSize="16sp"
                    android:hint="독서 후 느낌을 공유해 보세요!"
                    android:textColorHint="@color/hintColor"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:maxLines="15"
                    android:padding="8dp"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSummarize"
                android:layout_width="300dp"
                android:layout_height="45dp"
                android:layout_gravity="center_horizontal"
                android:text="요약하기"
                android:textColor="#000000"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:textSize="16sp"
                android:padding="5dp"
                android:visibility="gone"
                app:cornerRadius="20dp"
                android:backgroundTint="#306FB1DD"
                app:strokeWidth="2dp"
                android:layout_marginTop="10dp"
                app:strokeColor="#33888888"/>


            <!-- 책 정보 -->
            <include
                android:id="@+id/feedBookSearch"
                layout="@layout/book_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"/>

            <!-- 별점 커스텀용 LinearLayout -->
            <LinearLayout
                android:id="@+id/ratingContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center"
                android:layout_marginBottom="8dp"
                android:visibility="gone">
                <!-- ImageView 5개는 코드에서 동적으로 추가 -->
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 버튼 및 이미지 영역 (EditText 아래, 하단 버튼 위) -->
    <FrameLayout
        android:id="@+id/frameBottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@id/bottomLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/micON"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_gravity="bottom|center_horizontal"
            android:visibility="gone"
            android:padding="0dp">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieMicBars"
                android:layout_width="200dp"
                android:layout_height="80dp"
                android:layout_marginBottom="0dp"
                app:lottie_rawRes="@raw/audio_bar"
                app:lottie_autoPlay="false"
                app:lottie_loop="true"
                android:paddingLeft="30dp"
                android:paddingRight="30dp"
                android:clipToPadding="false"
                android:scaleType="centerCrop"/>

            <TextView
                android:id="@+id/tvRecording"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:text="음성을 인식중입니다..."
                android:gravity="center"
                android:paddingLeft="15dp"
                android:letterSpacing="0.1"
                android:textColor="#6FC1DD"
                android:textSize="14sp" />
        </LinearLayout>


        <!-- 요약 중 표시 (녹음 애니메이션과 동일 구조) -->
        <LinearLayout
            android:id="@+id/summarizing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_gravity="bottom|center_horizontal"
            android:visibility="gone"
            android:padding="0dp">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieChatGPTBars"
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:layout_marginBottom="10dp"
                app:lottie_rawRes="@raw/chatgpt_bar"
                app:lottie_autoPlay="false"
                app:lottie_loop="true"
                android:paddingLeft="30dp"
                android:paddingRight="30dp"
                android:clipToPadding="false"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tvSummarizing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:text="감상을 반영해 요약중입니다..."
                android:gravity="center"
                android:paddingLeft="15dp"
                android:letterSpacing="0.1"
                android:textColor="#6FC1DD"
                android:textSize="14sp" />
        </LinearLayout>


        <!-- 이미지 업로드 -->
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="bottom|right"
            android:layout_margin="20dp"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"/>
    </FrameLayout>


    <!-- 해시태그 입력란 -->
    <LinearLayout
        android:id="@+id/hashtagLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/round_background_20"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toTopOf="@id/bottomLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone">

        <EditText
            android:id="@+id/etHashtag"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="#해시태그 입력"
            android:background="@android:color/transparent"
            android:textColor="@color/text_blue"
            android:textColorHint="@color/hintColor"
            android:inputType="text"
            android:singleLine="true"/>
    </LinearLayout>

    <!-- 하단 버튼 영역 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 버튼 바로 위 구분선 -->
        <View
            android:id="@+id/dividerTop"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/btnGroup"
            android:layout_marginBottom="12dp"/>

        <!-- 버튼 그룹 좌측 -->
        <LinearLayout
            android:id="@+id/btnGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="10dp">

            <ImageButton
                android:id="@+id/btnAddFile"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/write_attach"
                android:scaleType="centerInside"
                android:padding="6dp"/>

            <View
                android:layout_width="2dp"
                android:layout_height="30dp"
                android:background="@color/bar"
                android:layout_marginEnd="8dp"/>

            <ImageButton
                android:id="@+id/btnHashtag"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/write_hashtag"
                android:scaleType="centerInside"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:paddingRight="13dp"/>

            <View
                android:layout_width="2dp"
                android:layout_height="30dp"
                android:background="@color/bar"
                android:layout_marginEnd="8dp"/>

            <ImageButton
                android:id="@+id/btnBook"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/write_book"
                android:scaleType="centerInside"
                android:padding="6dp"/>
        </LinearLayout>

        <!-- 마이크 버튼 (오른쪽) -->
        <ImageButton
            android:id="@+id/btnRecord"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/write_mic"
            android:scaleType="centerInside"
            android:padding="5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="10dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
