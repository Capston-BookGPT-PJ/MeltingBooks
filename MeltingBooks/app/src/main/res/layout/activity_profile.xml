<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/feed_background">

    <!-- 상단 바 (고정) -->
    <!--✅ 수정: Relative에서 ConstraintLayout으로 변경 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/top_bar_background"
        android:fitsSystemWindows="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 중앙 로고 -->
        <ImageView
            android:id="@+id/topBarImage"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/meltingbooks_toplog"
            android:contentDescription="Top Logo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- 우측 설정 버튼 -->
        <ImageButton
            android:id="@+id/goTo_App_setting"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:padding="10dp"
            android:background="@null"
            android:contentDescription="Setting Profile Button"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_setting"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- 스크롤 가능한 내용 영역 -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/topBar">
            <!--프로필 영역-->


            <!--최근 읽은 책-->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/profile_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/round_background_15"
                android:backgroundTint="#BFFFFFFF"
                android:paddingBottom="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/topBar">

                <!-- 프로필 백그라운드 이미지 -->
                <ImageView
                    android:id="@+id/profile_background_area"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp"
                    android:layout_marginTop="15dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/profile_background"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <!-- 반투명 흰색 원 (프로필 뷰보다 조금 큼) -->
                <View
                    android:id="@+id/profile_ring"
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:background="@drawable/circle_white_translucent"
                    android:translationY="-65dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/profile_background_area" />

                <!-- 실제 프로필 이미지 (원형) -->
                <ImageView
                    android:id="@+id/profile_image"
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:background="@drawable/profile_image_background"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/sample_profile"
                    android:translationY="-65dp"
                    app:layout_constraintBottom_toBottomOf="@+id/profile_ring"
                    app:layout_constraintEnd_toEndOf="@+id/profile_ring"
                    app:layout_constraintStart_toStartOf="@+id/profile_ring"
                    app:layout_constraintTop_toTopOf="@+id/profile_ring" />

                <TextView
                    android:id="@+id/profile_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-50dp"
                    android:text="내 이름"
                    android:textColor="@color/black"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="@+id/profile_area"
                    app:layout_constraintStart_toStartOf="@+id/profile_area"
                    app:layout_constraintTop_toBottomOf="@+id/profile_ring" />

                <TextView
                    android:id="@+id/profile_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:text="Lv.1"
                    android:textColor="#9C9C9C"
                    android:textSize="20sp"
                    android:translationY="-5dp"
                    app:layout_constraintBaseline_toBaselineOf="@id/profile_name"
                    app:layout_constraintEnd_toStartOf="@+id/profile_name" />

                <TextView
                    android:id="@+id/profile_tagid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="\@test_123"
                    android:textColor="#9C9C9C"
                    android:textSize="16sp"
                    android:translationY="-5dp"
                    app:layout_constraintBaseline_toBaselineOf="@id/profile_name"
                    app:layout_constraintBottom_toBottomOf="@+id/profile_name"
                    app:layout_constraintStart_toEndOf="@+id/profile_name" />


                <!--대표 배지 프로필 사진과 겹치게 닉네임 위-->
                <ImageView
                    android:id="@+id/representative_badge"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toTopOf="@id/profile_name"
                    app:layout_constraintStart_toStartOf="@id/profile_name"
                    app:layout_constraintEnd_toEndOf="@id/profile_name"/>



                <TextView
                    android:id="@+id/goTo_Profile_setting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="15dp"
                    android:background="@drawable/bg_follow_button"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="Edit profile"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/profile_ring"
                    app:layout_constraintTop_toBottomOf="@id/profile_background_area" />


                <TextView
                    android:id="@+id/profile_bio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="50dp"
                    android:gravity="center"
                    android:text="내 소개"
                    android:textColor="#434343"
                    android:textSize="18sp"
                    app:layout_constraintEnd_toEndOf="@+id/profile_area"
                    app:layout_constraintStart_toStartOf="@+id/profile_area"
                    app:layout_constraintTop_toBottomOf="@+id/profile_name" />

                <LinearLayout
                    android:id="@+id/follow_number_area"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="50dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/round_background_15"
                    android:backgroundTint="#BFFFFFFF"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="10dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/profile_area"
                    app:layout_constraintStart_toStartOf="@+id/profile_area"
                    app:layout_constraintTop_toBottomOf="@+id/profile_bio">

                    <!--포스트(리뷰) 수-->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/review_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="21"
                            android:textColor="@color/black"
                            android:textSize="32sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="posts"
                            android:textColor="#A6424242" />
                    </LinearLayout>

                    <!--팔로워 수-->
                    <LinearLayout
                        android:id="@+id/follower_area"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/follower_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="10dp"
                            android:text="48"
                            android:textColor="@color/black"
                            android:textSize="32sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="followers"
                            android:textColor="#A6424242" />
                    </LinearLayout>

                    <!--팔로잉 수-->
                    <LinearLayout
                        android:id="@+id/following_area"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/following_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="10dp"
                            android:text="21"
                            android:textColor="@color/black"
                            android:textSize="32sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="following"
                            android:textColor="#A6424242" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/recently_read_book"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/round_background_15"
                android:backgroundTint="#BFFFFFFF"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/profile_area">

                <TextView
                    android:id="@+id/recently_read_book_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="25dp"
                    android:layout_marginTop="10dp"
                    android:text="최근 읽은 책"
                    android:textColor="@color/black"
                    android:textSize="20sp" />

                <!-- 책 선택 영역 -->
                <LinearLayout
                    android:id="@+id/book_image_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="10dp"
                    android:clipChildren="false">

                    <LinearLayout
                        android:id="@+id/book_list_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:clipChildren="false"/>
                </LinearLayout>
            </LinearLayout>

            <!--최근 작성한 글-->
            <LinearLayout
                android:id="@+id/recent_reviews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/round_background_15"
                android:backgroundTint="#BFFFFFFF"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/recently_read_book"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                >

                <TextView
                    android:id="@+id/recently_reviews_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="최근 작성한 글"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    android:layout_marginTop="10dp"
                    android:layout_marginLeft="25dp" />

                <!-- 피드 RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/feedRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="15dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/recently_reviews_text"
                    app:layout_constraintVertical_bias="0.0" />

            </LinearLayout>

            <!--배지-->
            <LinearLayout
                android:id="@+id/badges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="100dp"
                android:background="@drawable/round_background_15"
                android:backgroundTint="#BFFFFFFF"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/recent_reviews"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                >

                <TextView
                    android:id="@+id/badges_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="배지"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    android:layout_marginTop="10dp"
                    android:layout_marginLeft="25dp"
                    />

                <!--배지 영역 -->
                <GridLayout
                    android:id="@+id/badge_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:alignmentMode="alignMargins"
                    android:columnOrderPreserved="false"
                    android:useDefaultMargins="true"
                    android:layout_marginHorizontal="10dp"
                    android:backgroundTint="#BFFFFFFF"
                    android:padding="10dp"/>

            </LinearLayout>


        </LinearLayout>

    </ScrollView>


    <!-- 하단 메뉴바-->
    <RelativeLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="11dp"
        android:layout_marginHorizontal="5dp"
        >

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/round_background_20"/>

        <!-- Gradient Circle Background -->
        <ImageView
            android:id="@+id/gradientCircle"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/gra_cir_img"
            android:layout_centerVertical="true"/>

        <!-- Bottom Navigation View -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigationView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@drawable/transparency"
            app:itemIconTint="@drawable/nav_item_selector"
            app:menu="@menu/bottom_nav_menu"
            app:labelVisibilityMode="unlabeled"/>
    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
